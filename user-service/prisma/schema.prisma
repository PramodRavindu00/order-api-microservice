generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id @default(uuid()) @db.Uuid
  accountId         String  @unique @db.Uuid
  firstName  String
  lastName String
  phoneNumber      String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}